# ai_financial_sns_page cron jobs
#
# NOT INSTALLED. This file is a draft for review/testing.
# To enable once you're ready: crontab scripts/crontab
# To check what's currently installed: crontab -l
# System timezone is Asia/Manila, matching PSE trading hours below.

PROJECT_DIR=/home/cjoyales/personal/ai_financial_sns_page
PYTHON=/home/cjoyales/personal/ai_financial_sns_page/.venv/bin/python

# Financial report disclosures: scrape, analyze, and post to Facebook.
# Every 30 min during PSE trading hours (9:30am-3:30pm), Mon-Fri.
# POST_MODE=auto is required here -- main.py's input() prompt would otherwise
# hang forever under cron. Confirm you're comfortable with unattended
# Facebook posting before enabling this line.
*/30 9-15 * * 1-5 cd $PROJECT_DIR && mkdir -p logs && POST_MODE=auto flock -n /tmp/ai_fsns_main.lock $PYTHON main.py >> logs/main.log 2>&1

# Market movers (gainers/losers/most active) has no standalone cron entry
# anymore -- market_movers_poster.py and financial_report_cards.py below
# both call scraper.market_movers.get_or_compute_movers(), which computes
# the live snapshot and caches it itself on a cache miss. A dedicated
# "just compute and cache" job would only be redundant work at this point.
# Run `python -m scraper.market_movers` manually if you ever want to
# refresh the company directory or force a fresh snapshot ad hoc.

# Market calendar (dividends/SROs/meetings/listings): cheap single-page
# fetch, refreshed daily for the current month.
30 16 * * 1-5 cd $PROJECT_DIR && mkdir -p logs && flock -n /tmp/ai_fsns_market_calendar.lock $PYTHON -m scraper.market_calendar >> logs/market_calendar.log 2>&1

# Market calendar graphic (PSEi + REIT watchlist, all event types): monthly
# preview of next month, same day as the dividend monthly cards.
10 8 25 * * cd $PROJECT_DIR && mkdir -p logs && POST_MODE=auto flock -n /tmp/ai_fsns_market_calendar_poster.lock $PYTHON dividend_posters.py month >> logs/market_calendar_poster.log 2>&1

# Year overview graphic (PSEi + REIT watchlist): full Jan-Dec dividend
# payout calendar for the current year. Refreshed monthly since more
# months get declared as the year progresses.
20 8 25 * * cd $PROJECT_DIR && mkdir -p logs && POST_MODE=auto flock -n /tmp/ai_fsns_year_overview_poster.lock $PYTHON dividend_posters.py year >> logs/year_overview_poster.log 2>&1

# Market movers poster (Top 10 Gainers / Losers / Most Active, PSE-wide):
# needs final end-of-day prices, so it runs after the 3:30pm close. Shares
# a same-day cached movers snapshot with financial_report_cards.py below
# via scraper.market_movers.get_or_compute_movers() -- whichever of the
# two jobs runs first for the day computes it live and caches it, the
# other reads that cache, so run order between them doesn't matter and
# the live scrape only happens once.
10 16 * * 1-5 cd $PROJECT_DIR && mkdir -p logs && POST_MODE=auto flock -n /tmp/ai_fsns_market_movers_poster.lock $PYTHON market_movers_poster.py >> logs/market_movers_poster.log 2>&1

# Financial report cards: mechanical trigger, posts a figures table for
# every company in today's top 10 gainers/losers/most-active (same shared
# cache as market_movers_poster.py above) -- using each company's most
# recent financial report on file, regardless of how old it is (the
# caption states the filing date so this isn't mistaken for today's
# news). Never selected by whether the figures look good. Runs once after
# market close (gainers/losers/most-active are end-of-day rankings, so
# this can no longer run intraday like main.py does).
20 16 * * 1-5 cd $PROJECT_DIR && mkdir -p logs && POST_MODE=auto flock -n /tmp/ai_fsns_financial_report_cards.lock $PYTHON financial_report_cards.py >> logs/financial_report_cards.log 2>&1
