# LLM providers (analysis step) - tried in this order, falls back automatically
LLM_PROVIDER_ORDER=gemini,claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Facebook Graph API (posting)
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# App dashboard -> Settings -> Basic. Used only by scripts/refresh_fb_token.py
# to exchange a short-lived token for a long-lived Page token.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# confirm = show a preview and ask before posting; auto = post immediately
POST_MODE=confirm
